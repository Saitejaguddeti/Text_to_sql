# Copy to .env and fill in.

# Chat model as provider:model. Install the matching extra: pip install -e ".[anthropic]" (or openai / bedrock)
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_MODEL=openai:<model name>        and OPENAI_API_KEY=
# LLM_MODEL=bedrock_converse:<model id> and the usual AWS credentials / AWS_REGION

# SQLite demo (build it with: python scripts/build_demo_db.py)
DATABASE_URL=sqlite:///demo.db
# Postgres from docker compose, connecting as the read-only role:
# DATABASE_URL=postgresql+psycopg://agent_reader:agent_reader@localhost:5432/bank
# Snowflake, with a role that only has USAGE and SELECT grants:
# DATABASE_URL=snowflake://USER:PASSWORD@ACCOUNT/DATABASE/SCHEMA?warehouse=WAREHOUSE&role=READ_ONLY_ROLE

# Business notes added to the prompt (column meanings, allowed values)
SCHEMA_NOTES_FILE=db/schema_notes.md

MAX_ROWS=200
MAX_ATTEMPTS=3
STATEMENT_TIMEOUT_MS=15000
